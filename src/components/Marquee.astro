---
// A band of alternating solid and hollow dots. Two identical halves make the loop seamless.
const dots = Array.from({ length: 56 });
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {dots.map(() => <b />)}
  </div>
</div>

<style>
  .marquee {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    padding: 24px 0;
    animation: marquee 44s linear infinite;
  }

  .marquee__track > :global(*) {
    margin-right: 56px;
  }

  .marquee b {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper);
  }

  .marquee b:nth-of-type(even) {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--paper);
  }

  @keyframes marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
</style>
